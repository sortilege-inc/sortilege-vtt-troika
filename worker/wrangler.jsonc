{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sortilege-vtt-troika",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // The app's own origins, comma-separated — the only non-localhost origins the Worker
    // answers to: the custom domain (D3, owner 2026-09-22) and the github.io address behind it.
    "ALLOWED_ORIGIN": "https://troika.sortilege.online,https://sortilege-inc.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION_ROOM", "class_name": "SessionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }]
}
